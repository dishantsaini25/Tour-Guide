# ─── Next.js build output ────────────────────────────────────
/.next/
/out/
/build
/dist/

# ─── Environment variables — NEVER commit these ──────────────
# Contains secrets: API keys, passwords, tokens
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env*.local

# ─── Public image folders — served from Cloudinary ───────────
# These folders are large and all images are hosted on Cloudinary.
# Run `npm run images:sync` to upload new images.
# Old misspelled folder (replaced by /experiences/)
public/experiances/
# New experiences image folder
public/experiences/
# Raw guest photos (uploaded to Cloudinary)
public/with guests/
# Journal images (uploaded to Cloudinary)
public/journal Images/

# ─── Cloudinary migration temp files ─────────────────────────
cloudinary-urls.json.tmp.*
*.tmp.*

# ─── Large / generated files ─────────────────────────────────
project_dump.txt

# ─── Testing ─────────────────────────────────────────────────
/coverage

# ─── OS / Editor files ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
